{
  "//": "Export-time brand replacement. Literal, case-sensitive, longest `from` first. `paths` limits a rule to those globs, `exclude` keeps it out of them. Never map DB identifiers (sfu_rec, sfss_purchase_url), the auth cookie name or package.json name fields. Prefer rewording a comment in source over adding a rule here. `\"path\": true` also renames every exported path the rule matches (a Kotlin package directory, an Xcode target folder), so a file's location changes in step with the contents naming it.",
  "skip": [
    "package-lock.json",
    "apps/*/public/tesseract/**",
    "apps/*/src/fonts/**"
  ],
  "rules": [
    {"from": "the SFU Badminton Club", "to": "the club", "note": "prose"},
    {"from": "The SFU Badminton Club", "to": "The club", "note": "prose"},
    {"from": "SFU Badminton Club", "to": "Club Ladder", "note": "product name"},
    {"from": "SFU BADMINTON CLUB", "to": "CLUB LADDER", "note": "upper-case wordmark"},
    {"from": "SFU BADMINTON", "to": "CLUB LADDER", "note": "upper-case wordmark"},
    {"from": "SFU Badminton Admin", "to": "Club Ladder Admin", "note": "console name"},
    {"from": "SFU Badminton", "to": "Club Ladder", "note": "product name"},
    {"from": "SFU Admin", "to": "Club Admin", "note": "console name"},
    {"from": "sfu-badminton", "to": "club-ladder", "note": "storage keys, file names"},
    {"from": "sfu_badmintonclub", "to": "clubladder", "note": "Instagram handle"},
    {"from": "sfubadminton.com", "to": "example.com", "note": "domain and every subdomain"},
    {"from": "sfubadminton", "to": "clubladder", "note": "bare handle; the mobile application id com.sfubadminton.app, its Kotlin package directories and the app URL scheme", "path": true},
    {"from": "SFUBadminton", "to": "ClubLadder", "note": "iOS XcodeGen project, target, Swift module and folder names", "path": true},
    {"from": "SfuBadminton", "to": "ClubLadder", "note": "Android theme name"},
    {"from": "@sfu.ca", "to": "@example.org", "note": "fixture and placeholder addresses. Kept out of migrations so a real address in a comment is redacted, not laundered", "exclude": ["supabase/migrations/**"]},
    {"from": "https://athleticsandrecreation.its.sfu.ca/Program/GetProgramDetails?courseId=b20a05ca-2754-4f11-ba1a-4a2ced47446c", "to": "https://recreation.example.org/membership", "note": "default membership purchase link", "paths": ["packages/shared/src/utils/membership-settings.ts", "packages/shared/src/utils/__tests__/membership-settings.test.ts"]},
    {"from": "\\bsfu\\s*rec(?:reation)?\\b", "to": "\\bcampus\\s*rec(?:reation)?\\b", "note": "OCR classifier, so mapped receipt fixtures still classify", "paths": ["packages/shared/src/utils/receipt-method.ts"]},
    {"from": "SFU Recreation", "to": "Campus Recreation", "note": "payment provider"},
    {"from": "SFU REC", "to": "CAMPUS REC", "note": "payment provider"},
    {"from": "SFU Rec", "to": "Campus Rec", "note": "payment provider"},
    {"from": "Lorne Davies Complex, Burnaby BC", "to": "Example Sports Centre", "note": "venue"},
    {"from": "Lorne Davies Complex", "to": "Example Sports Centre", "note": "venue"},
    {"from": "SFU Burnaby", "to": "Example Campus", "note": "venue"},
    {"from": "SFU Open", "to": "Club Open", "note": "tournament name"},
    {"from": "SFU student", "to": "student", "note": "membership label"},
    {"from": "x-sfu-viewer", "to": "x-club-viewer", "note": "header name"},
    {"from": "sfu-viewer-v1", "to": "club-viewer-v1", "note": "HMAC context"},
    {"from": "sfubad_", "to": "clubld_", "note": "data API key prefix, same length so key-shape tests hold"},
    {"from": "@SFU.ca", "to": "@EXAMPLE.org", "note": "mixed-case fixture addresses, so case-folding tests still fold", "exclude": ["supabase/migrations/**"]},
    {"from": "@SFU.CA", "to": "@EXAMPLE.ORG", "note": "upper-case fixture address", "exclude": ["supabase/migrations/**"]},
    {"from": "@sfu", "to": "@example", "note": "partial-address search fixtures, applied after the full forms", "exclude": ["supabase/migrations/**"]},
    {"from": "your SFU email", "to": "your school email", "note": "landing copy"},
    {"from": "an SFU email", "to": "a school email", "note": "release note on the sign-up placeholder"},
    {"from": "Burnaby Lake Sports Complex", "to": "Example Sports Complex", "note": "location placeholder"},
    {"from": "SFU alumni", "to": "Club alumni", "note": "role label fixture"},
    {"from": "SFU Gym", "to": "Example Gym", "note": "calendar fixture"},
    {"from": "classifyReceiptText('SFU')", "to": "classifyReceiptText('Club')", "note": "the club's own name alone must not classify", "paths": ["packages/shared/src/utils/__tests__/receipt-method.test.ts"]},
    {"from": "585f5ed2f67b8bf857a9866ee4de36c6df5f4e27efdccef43df4bf0955934a89", "to": "8749244bc84d815963722d3d380ab0f42d5f2988325d271524161515d01fb463", "note": "fixed sha256 vector of the mapped key prefix: printf 'clubld_' plus 43 A | shasum -a 256", "paths": ["apps/data-api/src/__tests__/key.test.ts", "apps/data-api-rs/tests/key.rs"]},
    {"from": "violates SFU policies", "to": "violates university policies", "note": "seeded Code of Conduct", "paths": ["supabase/migrations/**"]},
    {"from": "escalated to SFU or", "to": "escalated to the university or", "note": "seeded Code of Conduct", "paths": ["supabase/migrations/**"]},
    {"from": "SFU/club policy", "to": "university/club policy", "note": "seeded Terms of Use", "paths": ["supabase/migrations/**"]},
    {"from": "SFU requirements change.", "to": "university requirements change.", "note": "seeded waiver template", "paths": ["supabase/migrations/**"]},
    {"from": "go.sfss.ca", "to": "store.example.org", "note": "membership purchase link fixtures"},
    {"from": "SFSS grant", "to": "Student union grant", "note": "income fixture"}
  ]
}
