{
  "//": "Leak rules for the public export. `deny` overrides include.txt; `denyAllow` re-admits a denied path. A rule is a JavaScript regex, never with the g flag. `fail` stops the export, `warn` only reports. Exceptions are per path glob AND rule id, plus an optional `match` regex the line must satisfy; never a whole file for every rule. Personal values never live here: they come from the EXPORT_LEAK_PATTERNS secret.",
  "deny": [
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "auth-logs/**",
    "docs/sensitive/**",
    "**/CLAUDE.md",
    "**/docker-compose*.yml",
    ".github/**",
    "scripts/gen-db-types.profiles.json",
    "**/local.properties",
    "**/Local.xcconfig",
    "**/*.jks",
    "**/*.keystore",
    "**/*.p12",
    "**/*.mobileprovision",
    "**/GoogleService-Info*.plist",
    "**/google-services.json"
  ],
  "denyAllow": [
    "**/.env.example"
  ],
  "rules": [
    {"id": "polardev", "category": "infra", "level": "fail", "pattern": "polardev", "flags": "i"},
    {"id": "ssh-alias", "category": "infra", "level": "fail", "pattern": "\\bssh\\s+(?:-\\S+\\s+)*(?:pi|pi-remote|pi-lan)\\b", "flags": "i"},
    {"id": "host-alias", "category": "infra", "level": "fail", "pattern": "\\bpi-(?:remote|lan)\\b", "flags": "i"},
    {"id": "ssd-path", "category": "infra", "level": "fail", "pattern": "~/ssd|/mnt/ssd"},
    {"id": "home-bin", "category": "infra", "level": "fail", "pattern": "~/bin/"},
    {"id": "home-dir", "category": "infra", "level": "fail", "pattern": "/home/[a-z]|/Users/[A-Za-z]"},
    {"id": "ghcr", "category": "infra", "level": "fail", "pattern": "ghcr\\.io/", "flags": "i"},
    {"id": "goproxy", "category": "infra", "level": "fail", "pattern": "goproxy", "flags": "i"},
    {"id": "proxy-manager", "category": "infra", "level": "fail", "pattern": "proxy-manager", "flags": "i"},
    {"id": "mailpit", "category": "infra", "level": "fail", "pattern": "mailpit", "flags": "i"},
    {"id": "tailscale", "category": "infra", "level": "fail", "pattern": "tailscale", "flags": "i"},
    {"id": "launchd", "category": "infra", "level": "fail", "pattern": "launchd", "flags": "i"},
    {"id": "rclone", "category": "infra", "level": "fail", "pattern": "rclone", "flags": "i"},
    {"id": "plist", "category": "infra", "level": "fail", "pattern": "\\.plist\\b", "flags": "i"},
    {"id": "deploy-branch", "category": "infra", "level": "fail", "pattern": "deploy/docker-"},
    {"id": "db-container", "category": "infra", "level": "fail", "pattern": "docker exec[^\\n]*supabase-(?:staging-)?db"},
    {"id": "staging-container", "category": "infra", "level": "fail", "pattern": "supabase-staging", "flags": "i"},
    {"id": "ssh-port", "category": "infra", "level": "fail", "pattern": "(?:-p\\s*|:|port\\s+)2222\\b", "flags": "i"},
    {"id": "private-ip", "category": "infra", "level": "fail", "pattern": "\\b(?:10\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])|192\\.168)\\.\\d{1,3}\\.\\d{1,3}\\b"},
    {"id": "cgnat-ip", "category": "infra", "level": "fail", "pattern": "\\b100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.\\d{1,3}\\.\\d{1,3}\\b"},
    {"id": "pem-key", "category": "secret", "level": "fail", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"},
    {"id": "github-token", "category": "secret", "level": "fail", "pattern": "\\bghp_[A-Za-z0-9]{20,}"},
    {"id": "github-pat", "category": "secret", "level": "fail", "pattern": "\\bgithub_pat_[A-Za-z0-9_]{20,}"},
    {"id": "aws-key", "category": "secret", "level": "fail", "pattern": "\\bAKIA[0-9A-Z]{16}\\b"},
    {"id": "webhook-secret", "category": "secret", "level": "fail", "pattern": "\\bwhsec_[A-Za-z0-9+/=]{16,}"},
    {"id": "resend-key", "category": "secret", "level": "fail", "pattern": "\\bre_[A-Za-z0-9]{8,}_[A-Za-z0-9]{12,}"},
    {"id": "jwt", "category": "secret", "level": "fail", "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}"},
    {"id": "discord-token", "category": "secret", "level": "fail", "pattern": "\\b[MNO][A-Za-z\\d_-]{23,25}\\.[A-Za-z\\d_-]{6}\\.[A-Za-z\\d_-]{27,}\\b"},
    {"id": "the-pi", "category": "infra", "level": "warn", "pattern": "\\bthe Pi\\b|\\bPi's\\b", "exclude": ["supabase/migrations/**"]},
    {"id": "mac-mini", "category": "infra", "level": "warn", "pattern": "Mac mini", "flags": "i", "exclude": ["supabase/migrations/**"]},
    {"id": "the-pi-migration", "category": "infra", "level": "fail", "pattern": "\\bthe Pi\\b|\\bPi's\\b", "paths": ["supabase/migrations/**"], "//": "fails in migrations only, so a whole-line comment naming the host is redacted; anywhere else the-pi warns"},
    {"id": "mac-mini-migration", "category": "infra", "level": "fail", "pattern": "Mac mini", "flags": "i", "paths": ["supabase/migrations/**"], "//": "as the-pi-migration"},
    {"id": "cloudflare", "category": "infra", "level": "warn", "pattern": "cloudflare", "flags": "i"},
    {"id": "crontab", "category": "infra", "level": "warn", "pattern": "crontab", "flags": "i"},
    {"id": "brand-name", "category": "brand", "level": "fail", "pattern": "sfu[\\s_-]*badminton", "flags": "i"},
    {"id": "brand-word", "category": "brand", "level": "fail", "pattern": "\\bsfu\\b", "flags": "i"},
    {"id": "brand-prefix", "category": "brand", "level": "fail", "pattern": "sfubad", "flags": "i"},
    {"id": "venue", "category": "brand", "level": "fail", "pattern": "lorne\\s+davies", "flags": "i"},
    {"id": "city", "category": "brand", "level": "fail", "pattern": "burnaby", "flags": "i"}
  ],
  "emailAllow": [
    "example.com",
    "example.org",
    "example.net",
    "*.example",
    "*.test",
    "*.invalid",
    "localhost",
    "users.noreply.github.com"
  ],
  "binaryAllow": [
    "apps/*/src/fonts/**",
    "apps/*/public/tesseract/**",
    "apps/mobile/android/app/src/main/res/font/*.ttf",
    "apps/mobile/android/gradle/wrapper/gradle-wrapper.jar"
  ],
  "exceptions": [
    {"path": "apps/*/public/tesseract/**", "rule": "home-dir", "reason": "vendored Emscripten build output; the paths are the upstream build machine's, not ours"},
    {"path": "apps/player/src/lib/__tests__/guest-waiver-action.test.ts", "rule": "private-ip", "match": "x-forwarded-for", "reason": "a forwarded-for fixture; the private hop is what the test strips"},
    {"path": "apps/player/src/lib/discord-card.tsx", "rule": "private-ip", "match": "http://10\\.0\\.0\\.5:8000/", "reason": "the SSRF example the guard below it refuses"},
    {"path": "packages/shared/src/utils/member-identity.ts", "rule": "brand-word", "match": "^\\s*'sfu',\\s*$", "reason": "a reserved handle; it must match the v_reserved arrays in the migrations"},
    {"path": "supabase/migrations/00092_member_handle_and_number.sql", "rule": "brand-word", "match": "v_reserved TEXT\\[\\] := ARRAY\\[", "reason": "a reserved handle, mirrored in member-identity.ts"},
    {"path": "supabase/migrations/00235_backfill_handles_for_members_without_one.sql", "rule": "brand-word", "match": "v_reserved TEXT\\[\\] := ARRAY\\[", "reason": "a reserved handle, mirrored in member-identity.ts"},
    {"path": "apps/mobile/**", "rule": "plist", "match": "\\bInfo\\.plist\\b", "reason": "the iOS app's own Info.plist and the lines naming it; the rule is for launchd job plists"},
    {"path": "package-lock.json", "rule": "email-domain", "reason": "third-party package author metadata written by npm"},
    {"path": "apps/*/src/lib/__tests__/auth-telemetry.test.ts", "rule": "email-domain", "reason": "a synthetic one-letter address the scrubber must redact"},
    {"path": "packages/shared/src/email/__tests__/unsubscribe.test.ts", "rule": "email-domain", "reason": "a synthetic one-letter address used as token input"},
    {"path": "packages/shared/src/utils/__tests__/membership-settings.test.ts", "rule": "email-domain", "match": "@c\\.com", "reason": "malformed-address fixtures the validator must reject"},
    {"path": "packages/shared/src/utils/__tests__/club-socials.test.ts", "rule": "email-domain", "match": "//[^/@\\s]+:[^/@\\s]+@", "reason": "userinfo in a URL the validator must reject, not an address"}
  ]
}
